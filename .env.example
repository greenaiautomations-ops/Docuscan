# --- Frontend (Vite) ---
# Supabase project URL and anon (public) key.
# Find these in your Supabase project: Settings -> API.
# The anon key is safe to expose in frontend code — it relies on RLS for security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Edge Function secrets (set these with `supabase secrets set`, NEVER in this file) ---
# GEMINI_API_KEY=AQ....               # required — OCR + AI (classification, extraction, summary,
#                                      # translation, chat) and embeddings. Free tier, no credit card:
#                                      # https://aistudio.google.com/apikey
#                                      # New Google AI Studio keys use the "AQ." auth-key prefix;
#                                      # older "AIza..." Standard keys still work too. Copy the exact
#                                      # key string via AI Studio's "Copy key" button.
# GEMINI_MODEL=gemini-3.1-flash-lite  # optional override (this is also the default).
#                                      # Flash-Lite is used by default instead of the plain
#                                      # "-latest" Flash alias because Google cut the full
#                                      # Flash free tier hard in late 2025 (as low as ~20
#                                      # requests/day in some configs) while Flash-Lite kept a
#                                      # much higher free daily quota. Set this only if you're
#                                      # on a paid plan and want the full model's higher quality.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001  # optional override
#
# Alternative provider (swap by changing the import in the Edge Functions from
# geminiProvider.ts to anthropicProvider.ts — same interface):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
#
# NEVER put the service_role key, or any AI/OCR provider secret, in this file
# or anywhere in frontend code (nothing prefixed VITE_ should ever hold a
# secret — everything with VITE_ is bundled into the client). Those belong
# only in Supabase Edge Function secrets, configured via:
#   supabase secrets set GEMINI_API_KEY=AQ....
#
# --- Subscriptions & billing (Stripe) — Edge Function secrets ---
# STRIPE_SECRET_KEY=sk_test_...        # required — Stripe Dashboard -> Developers -> API keys.
#                                       # Use a test-mode key (sk_test_...) until you're ready to
#                                       # take real payments.
# STRIPE_WEBHOOK_SECRET=whsec_...      # required — Dashboard -> Developers -> Webhooks -> your
#                                       # endpoint -> Signing secret. Without this, the webhook
#                                       # will reject every event (signature verification fails).
# STRIPE_PRICE_BASIC=price_...         # required — the Basic (€6.99/mo, VAT-inclusive) recurring price's API ID.
# STRIPE_PRICE_PRO=price_...           # required — the Pro (€17.99/mo, VAT-inclusive) recurring price's API ID.
#                                       # See README "6. Set up Stripe" for the full walkthrough
#                                       # (creating products/prices, the webhook, and the portal).
#
# --- Phase 3: scheduled reminders (process-reminders Edge Function) ---
# process-reminders runs under the service_role on a schedule (pg_cron +
# pg_net, or the Supabase Dashboard's Cron Jobs UI) — it is never called
# from the browser and needs no VITE_/frontend env var. Its own
# authentication is the Supabase-issued service_role key, supplied as a
# Bearer token in the cron job's HTTP header (via Supabase Vault, not this
# file). See README "Set up scheduled reminders" for the exact steps.

# APP_URL=https://your-docvault-domain.example # required, trusted billing return origin
# STRIPE_PRICE_BUSINESS=price_...        # €49/month, tax_behavior=inclusive
# STRIPE_PRICE_ADDON_PAGES=price_...     # €2 one-time / 100 pages, inclusive
# STRIPE_PRICE_ADDON_QUESTIONS=price_... # €3 one-time / 100 AI requests, inclusive
# STRIPE_PRICE_ADDON_STORAGE=price_...   # €2/month / 5 GB, inclusive
# STRIPE_PRICE_ADDON_SEATS=price_...     # €5/month / additional Business member, inclusive
# Enable Stripe Tax and automatic tax for Checkout; all configured prices must
# use EUR and inclusive tax behavior. Configure the Billing Portal to support
# base-plan changes and cancellation of recurring add-on subscriptions.
