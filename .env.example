# --- Frontend (Vite) ---
# Supabase project URL and anon (public) key.
# Find these in your Supabase project: Settings -> API.
# The anon key is safe to expose in frontend code — it relies on RLS for security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Edge Function secrets (Phase 2 — set these with `supabase secrets set`, NEVER in this file) ---
# ANTHROPIC_API_KEY=sk-ant-...        # OCR + AI (classification, extraction, summary, translation, chat)
# ANTHROPIC_MODEL=claude-sonnet-5     # optional override
# VOYAGE_API_KEY=pa-...               # optional — embeddings for Phase 3 semantic search; safe to omit
#
# NEVER put the service_role key, or any AI/OCR provider secret, in this file
# or anywhere in frontend code (nothing prefixed VITE_ should ever hold a
# secret — everything with VITE_ is bundled into the client). Those belong
# only in Supabase Edge Function secrets, configured via:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set VOYAGE_API_KEY=pa-...
