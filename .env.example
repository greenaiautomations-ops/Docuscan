# --- Frontend (Vite) ---
# Supabase project URL and anon (public) key.
# Find these in your Supabase project: Settings -> API.
# The anon key is safe to expose in frontend code — it relies on RLS for security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Edge Function secrets (Phase 2 — set these with `supabase secrets set`, NEVER in this file) ---
# GEMINI_API_KEY=AIza...              # required — OCR + AI (classification, extraction, summary,
#                                      # translation, chat) and embeddings. Free tier, no credit card:
#                                      # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-flash-latest    # optional override
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001  # optional override
#
# Alternative provider (swap by changing the import in the three Edge
# Functions from geminiProvider.ts to anthropicProvider.ts — same interface):
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
#
# NEVER put the service_role key, or any AI/OCR provider secret, in this file
# or anywhere in frontend code (nothing prefixed VITE_ should ever hold a
# secret — everything with VITE_ is bundled into the client). Those belong
# only in Supabase Edge Function secrets, configured via:
#   supabase secrets set GEMINI_API_KEY=AIza...
