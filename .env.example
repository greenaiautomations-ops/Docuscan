# Supabase project URL and anon (public) key.
# Find these in your Supabase project: Settings -> API.
# The anon key is safe to expose in frontend code — it relies on RLS for security.
# NEVER put the service_role key or any AI/OCR provider secret in this file
# or anywhere in frontend code. Those belong in Supabase Edge Function secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
